diff --git a/runtime/src/guppi_runtime/uix/ui/tokens.css b/runtime/src/guppi_runtime/uix/ui/tokens.css
index 6283506..007c793 100644
--- a/runtime/src/guppi_runtime/uix/ui/tokens.css
+++ b/runtime/src/guppi_runtime/uix/ui/tokens.css
@@ -160,3 +160,19 @@ button:focus-visible,[role="button"]:focus-visible,.s-row:focus-visible,input:fo
 .s-empty{color:var(--muted);padding:10px 0}
 
 @media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important}}
+
+/* Gestaltung „KI Gateway für KMU“ (Shell gateway-kmu, Folien B6, 19.10.2026): Farben aus den Folien gemessen.
+   Nur für diese Shell; die übrigen Shells und Werkzeuge kennen die Namen nicht und bleiben unverändert. */
+:root{
+  --kmu-bg:#0d174e;        /* Folienhintergrund */
+  --kmu-deep:#080d33;      /* Schlussfolie, tiefer Hintergrund */
+  --kmu-box:#243269;       /* Kästchen des Ablaufs */
+  --kmu-box-2:#1a2862;     /* innere Fläche */
+  --kmu-line:#2c3d86;      /* feine Linie */
+  --kmu-accent:#53ddd0;    /* türkiser Akzentstrich */
+  --kmu-title:#ffffff;     /* Überschrift */
+  --kmu-sub:#b4c2ec;       /* Untertitel */
+  --kmu-text:#e8edff;      /* Fließtext */
+  --kmu-titel-groesse:34px;   /* Titel der Folien */
+  --kmu-sub-groesse:17px;     /* Untertitel */
+}
