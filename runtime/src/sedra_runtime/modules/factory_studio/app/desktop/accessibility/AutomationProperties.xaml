<!-- 
AutomationProperties Helper — XAML Attached Properties für Barrierefreiheit.
Datei: Accessibility/AutomationProperties.xaml
Namespace: Sedra.FactoryStudio.Accessibility
Verwendung: <Button accessibility:AutomationProperties.Name="Genehmigen" ... />
-->

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sedra.FactoryStudio.Accessibility">

    <!-- AutomationProperties.Name - Für Screen Reader -->
    <Style TargetType="Button" x:Key="AccessibleButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding AutomationHelp, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style TargetType="TextBox" x:Key="AccessibleTextBoxStyle" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding PlaceholderText, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding ToolTipService.ToolTip, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style TargetType="ComboBox" x:Key="AccessibleComboBoxStyle" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="AutomationProperties.Name" Value="{Binding PlaceholderText, RelativeSource={RelativeSource Self}}"/>
    </Style>

    <Style TargetType="ListView" x:Key="AccessibleListViewStyle" BasedOn="{StaticResource DefaultListViewStyle}">
        <Setter Property="AutomationProperties.Name" Value="Liste"/>
    </Style>

    <Style TargetType="TreeView" x:Key="AccessibleTreeViewStyle" BasedOn="{StaticResource DefaultTreeViewStyle}">
        <Setter Property="AutomationProperties.Name" Value="Baumansicht"/>
    </Style>

    <!-- Attached Properties für einfache Nutzung -->
    <!-- Usage: <Button acc:AutomationProperties.Name="Genehmigen" ... /> -->
    
    <!-- AutomationProperties.LiveRegion für dynamische Updates -->
    <Style TargetType="TextBlock" x:Key="LiveRegionTextBlockStyle">
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>

    <Style TargetType="ProgressRing" x:Key="AccessibleProgressRingStyle">
        <Setter Property="AutomationProperties.Name" Value="Ladevorgang"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Assertive"/>
    </Style>

    <!-- Focus Visual für Tastatur-Navigation -->
    <Style TargetType="Control" x:Key="FocusableControlStyle">
        <Setter Property="FocusVisualMargin" Value="-2"/>
        <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource SystemControlFocusVisualPrimaryBrush}"/>
        <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource SystemControlFocusVisualSecondaryBrush}"/>
        <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
        <Setter Property="FocusVisualSecondaryThickness" Value="1"/>
    </Style>

    <!-- High Contrast Support -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="HighContrast">
            <!-- High Contrast Farben für Buttons -->
            <SolidColorBrush x:Key="ButtonBackground" Color="{ThemeResource SystemColorButtonFaceColor}"/>
            <SolidColorBrush x:Key="ButtonForeground" Color="{ThemeResource SystemColorButtonTextColor}"/>
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
            
            <!-- Focus -->
            <SolidColorBrush x:Key="FocusVisualPrimaryBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
            <SolidColorBrush x:Key="FocusVisualSecondaryBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Light">
            <!-- Standard Light Theme -->
        </ResourceDictionary>
        
        <ResourceDictionary x:Key="Dark">
            <!-- Standard Dark Theme -->
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>