<!-- 
VirtualizingTreeView — TreeView mit Virtualisierung für große Hierarchien.
WinUI 3 TreeView unterstützt Virtualisierung nicht nativ, daher Custom Control.
Datei: Controls/VirtualizingTreeView.xaml
Namespace: Sedra.FactoryStudio.Controls
-->

<UserControl
    x:Class="Sedra.FactoryStudio.Controls.VirtualizingTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="400" d:DesignWidth="400">

    <Grid>
        <!-- ScrollViewer für Virtualisierung -->
        <ScrollViewer x:Name="ScrollViewer" 
                      VerticalScrollMode="Auto" 
                      HorizontalScrollMode="Auto"
                      ZoomMode="Disabled">
            
            <!-- ItemsRepeater mit VirtualizingLayout -->
            <ItemsRepeater x:Name="ItemsRepeater" 
                           ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                
                <ItemsRepeater.Layout>
                    <!-- VirtualizingStackLayout für vertikale Virtualisierung -->
                    <VirtualizingStackLayout 
                        Orientation="Vertical"
                        Spacing="0"
                        ItemSpacing="0"
                        LineAlignment="Start"/>
                </ItemsRepeater.Layout>
                
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:TreeNodeViewModel">
                        <!-- TreeNode mit Indentation basierend auf Level -->
                        <Grid x:Name="NodeGrid" 
                              Background="{x:Bind IsSelected, Converter={StaticResource BoolToBackgroundConverter}, Mode=OneWay}"
                              Padding="{x:Bind IndentThickness, Mode=OneWay}"
                              RightTapped="NodeGrid_RightTapped"
                              PointerPressed="NodeGrid_PointerPressed"
                              ContextRequested="NodeGrid_ContextRequested">
                            
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- Expander -->
                                <ColumnDefinition Width="Auto"/>  <!-- Icon -->
                                <ColumnDefinition Width="*"/>     <!-- Content -->
                                <ColumnDefinition Width="Auto"/>  <!-- Badge -->
                            </Grid.ColumnDefinitions>
                            
                            <!-- Expander Chevron -->
                            <FontIcon Grid.Column="0" 
                                      Glyph="{x:Bind IsExpanded, Converter={StaticResource BoolToChevronConverter}, Mode=OneWay}"
                                      FontSize="12" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      Visibility="{x:Bind HasChildren, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      PointerPressed="Expander_PointerPressed"/>
                            
                            <!-- Node Icon -->
                            <FontIcon Grid.Column="1" 
                                      Glyph="{x:Bind NodeType, Converter={StaticResource NodeTypeToIconConverter}, Mode=OneWay}"
                                      FontSize="14" 
                                      Foreground="{x:Bind Status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"
                                      VerticalAlignment="Center" Margin="0,0,8,0"/>
                            
                            <!-- Content -->
                            <StackPanel Grid.Column="2" Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" 
                                           FontWeight="{x:Bind IsBold, Converter={StaticResource BoolToFontWeightConverter}, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind Subtitle, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}"/>
                            </StackPanel>
                            
                            <!-- Badges -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <controls:InfoBadge Value="{x:Bind ChildrenCount, Mode=OneWay}" 
                                                    Visibility="{x:Bind ChildrenCount > 0, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                                <controls:InfoBadge Value="{x:Bind ArtifactsCount, Mode=OneWay}" 
                                                    Visibility="{x:Bind ArtifactsCount > 0, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</UserControl>