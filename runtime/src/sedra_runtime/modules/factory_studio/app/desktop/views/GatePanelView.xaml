<!-- 
Factory Studio GatePanel View (WinUI 3 XAML)
Datei: Views/GatePanelView.xaml
Namespace: Sedra.FactoryStudio.Views
ViewModel: GatePanelViewModel
Kann als Flyout, Pane oder Inline in StatusDashboard eingebunden werden.
-->

<UserControl
    x:Class="Sedra.FactoryStudio.Views.GatePanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Sedra.FactoryStudio.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:Sedra.FactoryStudio.Converters"
    mc:Ignorable="d"
    d:DesignWidth="400">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:GateTypeToIconConverter x:Key="GateTypeToIconConverter"/>
        
        <!-- Gate Item Template (compact für Panel) -->
        <DataTemplate x:Key="CompactGateItemTemplate" x:DataType="vm:GateItemViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10" Margin="0,0,0,6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Type Icon -->
                    <FontIcon Grid.Column="0" Glyph="{x:Bind gate_type, Converter={StaticResource GateTypeToIconConverter}, Mode=OneWay}"
                              FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <!-- Info -->
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind gate_type, Mode=OneWay}" FontWeight="Medium" FontSize="13"/>
                            <controls:InfoBadge Value="{x:Bind status, Mode=OneWay}" 
                                                Foreground="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind requested_by, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11"/>
                            <TextBlock Text="•" Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind requested_at, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}, Mode=OneWay}" 
                                       Style="{StaticResource CaptionTextBlockStyle}" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                Visibility="{x:Bind status == 'pending', Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Button Content="✓" Style="{StaticResource AccentButtonStyle}" Width="32" Height="32"
                                Command="{x:Bind ViewModel.approve_gate_command, Mode=OneWay}"
                                CommandParameter="{x:Bind gate_id, Mode=OneWay}"
                                ToolTipService.ToolTip="Genehmigen"/>
                        <Button Content="✕" Style="{StaticResource ButtonStyle}" Width="32" Height="32"
                                Command="{x:Bind ViewModel.reject_gate_command, Mode=OneWay}"
                                CommandParameter="{x:Bind gate_id, Mode=OneWay}"
                                ToolTipService.ToolTip="Ablehnen"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="12" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE77B;" FontSize="18" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Spacing="2">
                    <TextBlock Text="Captain Gates" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                        <controls:InfoBadge Value="{x:Bind ViewModel.pending_count, Mode=OneWay}" 
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        <TextBlock Text="offen" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        <!-- Gates List -->
        <ListView Grid.Row="1" x:Name="GatesListView"
                  ItemsSource="{x:Bind ViewModel.gates, Mode=OneWay}"
                  ItemTemplate="{StaticResource CompactGateItemTemplate}"
                  SelectionMode="None"
                  Background="Transparent">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
        
        <!-- Empty State -->
        <StackPanel Grid.Row="1" Visibility="{x:Bind ViewModel.gates.Count == 0, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                    Orientation="Horizontal" Spacing="12" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE73E;" FontSize="24" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <StackPanel Spacing="4">
                <TextBlock Text="Keine offenen Gates" Style="{StaticResource BodyTextBlockStyle}"/>
                <TextBlock Text="Alle Entscheidungen erledigt." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>