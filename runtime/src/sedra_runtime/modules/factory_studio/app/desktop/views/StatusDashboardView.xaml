<!-- 
Factory Studio StatusDashboard View (WinUI 3 XAML)
Datei: Views/StatusDashboardView.xaml
Namespace: Sedra.FactoryStudio.Views
ViewModel: StatusDashboardViewModel
-->

<Page
    x:Class="Sedra.FactoryStudio.Views.StatusDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Sedra.FactoryStudio.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:converters="using:Sedra.FactoryStudio.Converters"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        
        <!-- Health Card Template -->
        <DataTemplate x:Key="HealthCardTemplate" x:DataType="vm:HealthCardViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="16" MinWidth="200" MaxWidth="280">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Ellipse Width="16" Height="16" 
                                 Fill="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind title, Mode=OneWay}" 
                                   Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind value, Mode=OneWay}" 
                               FontSize="32" FontWeight="Bold" 
                               Foreground="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind subtitle, Mode=OneWay}" 
                               Style="{StaticResource CaptionTextBlockStyle}"/>
                    <ProgressBar Value="{x:Bind progress, Mode=OneWay}" 
                                 Maximum="100" Height="6" 
                                 Visibility="{x:Bind show_progress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                 Margin="0,8,0,0"
                                 Foreground="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        
        <!-- Gate Item Template -->
        <DataTemplate x:Key="GateItemTemplate" x:DataType="vm:GateItemViewModel">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto" Padding="4">
                    <!-- Gate Type Icon -->
                    <FontIcon Grid.Column="0" Glyph="{x:Bind gate_type, Converter={StaticResource GateTypeToIconConverter}, Mode=OneWay}"
                              FontSize="20" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    
                    <!-- Gate Info -->
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind gate_type, Mode=OneWay}" FontWeight="Medium"/>
                            <controls:InfoBadge Value="{x:Bind status, Mode=OneWay}" 
                                                Foreground="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{x:Bind requested_by, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"/>
                            <TextBlock Text="•" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind requested_at, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}, Mode=OneWay}" 
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <TextBlock Text="{x:Bind target_id, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Consolas"/>
                    </StackPanel>
                    
                    <!-- Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                Visibility="{x:Bind status == 'pending', Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Button Content="Genehmigen" Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.approve_gate_command, Mode=OneWay}"
                                CommandParameter="{x:Bind gate_id, Mode=OneWay}"/>
                        <Button Content="Ablehnen" Style="{StaticResource ButtonStyle}"
                                Command="{x:Bind ViewModel.reject_gate_command, Mode=OneWay}"
                                CommandParameter="{x:Bind gate_id, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Toolbar -->
        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <AppBarButton Icon="Refresh" Label="Aktualisieren" 
                          Command="{x:Bind ViewModel.refresh_command, Mode=OneWay}"/>
            <AppBarButton Icon="Setting" Label="Einstellungen" 
                          Command="{x:Bind ViewModel.settings_command, Mode=OneWay}"/>
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0">
                    <TextBlock Text="Factory Studio — Status & Captain Gates" 
                               Style="{StaticResource TitleTextBlockStyle}" 
                               VerticalAlignment="Center"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.is_loading, Mode=OneWay}" 
                                  Width="20" Height="20" Margin="12,0,0,0"/>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollMode="Auto" Padding="12">
            <StackPanel Spacing="24">
                <!-- Factory Health Cards -->
                <StackPanel x:Name="HealthSection">
                    <TextBlock Text="Factory Health" Style="{StaticResource TitleTextBlockStyle}"/>
                    <controls:ItemsRepeater x:Name="HealthCards" ItemsSource="{x:Bind ViewModel.health_cards, Mode=OneWay}">
                        <controls:ItemsRepeater.Layout>
                            <controls:UniformGridLayout MinItemWidth="220" MaxItemWidth="280" Orientation="Horizontal" MinRowSpacing="12" MinColumnSpacing="12"/>
                        </controls:ItemsRepeater.Layout>
                        <controls:ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:HealthCardViewModel">
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="16" MinWidth="200" MaxWidth="280">
                                    <StackPanel Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Ellipse Width="16" Height="16" 
                                                     Fill="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind title, Mode=OneWay}" 
                                                       Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind value, Mode=OneWay}" 
                                                   FontSize="32" FontWeight="Bold" 
                                                   Foreground="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind subtitle, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}"/>
                                        <ProgressBar Value="{x:Bind progress, Mode=OneWay}" 
                                                     Maximum="100" Height="6" 
                                                     Visibility="{x:Bind show_progress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                                     Margin="0,8,0,0"
                                                     Foreground="{x:Bind status, Converter={StaticResource StatusToColorConverter}, Mode=OneWay}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </controls:ItemsRepeater.ItemTemplate>
                    </controls:ItemsRepeater>
                </StackPanel>
                
                <!-- Captain Gates -->
                <StackPanel x:Name="GatesSection" Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <TextBlock Text="Captain Gates" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <controls:InfoBadge Value="{x:Bind ViewModel.pending_gates_count, Mode=OneWay}" 
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                    </StackPanel>
                    
                    <ListView x:Name="GatesList" ItemsSource="{x:Bind ViewModel.gates, Mode=OneWay}"
                              ItemTemplate="{StaticResource GateItemTemplate}"
                              SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                    
                    <!-- Empty State -->
                    <StackPanel x:Name="NoGatesPanel" Visibility="{x:Bind ViewModel.gates.Count == 0, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"
                                Orientation="Horizontal" Spacing="12" Padding="24" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xE73E;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Keine offenen Gates" Style="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Text="Alle Captain-Entscheidungen sind erledigt." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- Recent Activity -->
                <StackPanel x:Name="ActivitySection" Margin="0,24,0,0">
                    <TextBlock Text="Letzte Aktivität" Style="{StaticResource TitleTextBlockStyle}"/>
                    <ListView x:Name="ActivityList" ItemsSource="{x:Bind ViewModel.recent_activity, Mode=OneWay}"
                              SelectionMode="None" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActivityItemViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="12" Padding="8,4">
                                    <Ellipse Width="8" Height="8" 
                                             Fill="{x:Bind type, Converter={StaticResource ActivityTypeToColorConverter}, Mode=OneWay}"
                                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind message, Mode=OneWay}"/>
                                        <TextBlock Text="{x:Bind timestamp, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Status Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" 
                    Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{x:Bind ViewModel.status_message, Mode=OneWay}" 
                       Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
            <TextBlock Text="{x:Bind ViewModel.last_refresh, Mode=OneWay, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='Letzte Aktualisierung: {0}'}" 
                       Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</Page>