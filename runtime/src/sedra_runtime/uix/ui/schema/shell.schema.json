{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sedra-ui/shell.schema.json",
  "title": "shell.yaml – a SEDRA shell (UI contract 1.0)",
  "description": "Exactly one shell is active. It owns the screen and gives the tools their containers; it never reaches into a tool.",
  "type": "object",
  "required": [
    "shell"
  ],
  "additionalProperties": false,
  "properties": {
    "shell": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "entry",
        "provides",
        "trust",
        "needs"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "entry": {
          "type": "object",
          "required": [
            "js"
          ],
          "additionalProperties": false,
          "properties": {
            "js": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "css": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            }
          }
        },
        "provides": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "strip",
              "tree",
              "dock",
              "talk",
              "palette",
              "windows",
              "menubar",
              "notify",
              "inbox",
              "chooser"
            ]
          },
          "description": "which slots this shell offers; a tool asks for none of them, it only gets a container"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "persist": {
              "enum": [
                "browser",
                "none"
              ]
            }
          }
        },
        "api": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(GET|POST) /(api|uix)(/[A-Za-z0-9_.-]+)*(/\\*)?$"
          }
        },
        "trust": {
          "enum": [
            "CORE",
            "CAPTAIN",
            "SEDRA_BUILT",
            "COMMUNITY"
          ]
        },
        "needs": {
          "type": "object",
          "required": [
            "ui"
          ],
          "additionalProperties": false,
          "properties": {
            "ui": {
              "type": "string"
            }
          }
        },
        "umschalter": {
          "enum": [
            "chip",
            "menue"
          ],
          "description": "Vertrag Nachtrag N3 (Harness Stufe 4): chip = Alt+S-Chip und Mini-Hub der Seite (Vorgabe); menue = die Shell hat ein eigenes Start-Menü, Alt+S ruft ihren Haken."
        },
        "grundfunktionen": {
          "type": "object",
          "propertyNames": {"enum": ["entscheidungen", "gespraech", "aufgaben", "logbuch", "modus_grenzen", "module_berechtigungen", "einstellungen_zustand"]},
          "additionalProperties": {"type": "string", "pattern": "^(ort|eigen|verwaltung|slot:[a-z]+)$"},
          "description": "AM2-14: wie die Shell jede der sieben Grundfunktionen erreichbar macht: ort (über einen Ort, das Start-Menü oder die Palette), slot:<name> (eigener Slot), eigen (eigene Fläche mit data-grundfunktion), verwaltung (nur Verwaltungszugang, ab AM7). Fehlt eine, warnt der Kern (Vertrag 1.1)."
        },
        "archiv": {"type": "boolean", "description": "AM2-17: Archiv-Shell (z. B. sedra-xp) – muss nur module_berechtigungen und den Wechsel in eine andere Shell erreichbar machen."},
        "einstieg": {"type": "boolean", "description": "AM2-17: Einstiegs-Shell (z. B. start) – muss nur module_berechtigungen und den Wechsel erreichbar machen."}
      }
    }
  }
}
