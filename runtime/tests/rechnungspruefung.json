      "id": "f3f01956-1aba-4e44-9848-7f8ec148df0b",
      "name": "Kostenübersicht",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1808,
        16
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst text = $('Rechnungstext vorbereiten').first().json.Rechnungstext;\n\nconst zahl = s => Number(s.replace(/\\./g, '').replace(',', '.'));\n\nconst starts = [...text.matchAll(\n  /^(\\d{2}\\.\\d{2}\\.\\d{4})(?=\\s|$)/gm\n)].filter(m => !/^\\d{2}\\.\\d{2}\\.20\\d{2}$/.test(m[1]));\n\nconst positionen = [];\nconst lesefehler = [];\n\nfor (let i = 0; i < starts.length; i++) {\n  const position = starts[i][1];\n  const beginn = starts[i].index + starts[i][0].length;\n  const ende = i + 1 < starts.length\n    ? starts[i + 1].index\n    : text.length;\n\n  const abschnitt = text.slice(beginn, ende);\n\n  const zahlen = [...abschnitt.matchAll(\n    /(\\d+)\\s+(psch\\.|Stk\\.|m²|m)\\s+([\\d.]+,\\d{2})\\s+([\\d.]+,\\d{2})(?=\\s|$)/g\n  )];\n\n  if (zahlen.length !== 1) {\n    lesefehler.push({\n      position,\n      grund: 'Zahlen nicht eindeutig erkannt'\n    });\n    continue;\n  }\n\n  const m = zahlen[0];\n  const menge = Number(m[1]);\n  const einzelpreis = zahl(m[3]);\n  const gesamtpreis = zahl(m[4]);\n  const berechnet = Math.round(menge * einzelpreis * 100) / 100;\n\n  positionen.push({\n    position,\n    menge,\n    einzelpreis,\n    gesamtpreis,\n    berechnet,\n    korrekt: Math.abs(berechnet - gesamtpreis) < 0.01\n  });\n}\n\nreturn [{\n  json: {\n    anzahl: positionen.length,\n    positionen,\n    lesefehler,\n    status: lesefehler.length === 0 && positionen.length > 0\n      ? 'Positionen ausgelesen'\n      : 'MANUELLE PRÜFUNG ERFORDERLICH'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "id": "553c9d20-c3d7-4276-b512-faf9370bb8ec",
      "name": "Rechnungspositionen auslesen"
    },
    {
      "parameters": {
        "jsCode": "\nconst rechnung = $('Rechnungspositionen auslesen').first().json.positionen;\nconst auftrag = $('Auftragspositionen abrufen').all().map(item => item.json);\n\nconst cent = n => Math.round(Number(n) * 100);\n\nconst ergebnisse = rechnung.map(r => {\n  const a = auftrag.find(p => p.lv_position === r.position);\n\n  if (!a) {\n    return {\n      position: r.position,\n      status: 'NICHT IM AUFTRAG'\n    };\n  }\n\n  const mengenOK = r.menge === Number(a.menge);\n  const preisOK = cent(r.einzelpreis) === cent(a.einzelpreis_netto);\n  const summeOK = cent(r.gesamtpreis) === cent(a.gesamtpreis_netto);\n  const rechnungOK = r.korrekt === true;\n\n  return {\n    position: r.position,\n    menge_rechnung: r.menge,\n    menge_auftrag: Number(a.menge),\n    einzelpreis_rechnung: r.einzelpreis,\n    einzelpreis_auftrag: Number(a.einzelpreis_netto),\n    summe_rechnung: r.gesamtpreis,\n    summe_auftrag: Number(a.gesamtpreis_netto),\n    status: mengenOK && preisOK && summeOK && rechnungOK\n      ? 'OK'\n      : 'ABWEICHUNG'\n  };\n});\n\nconst fehlendePositionen = auftrag\n  .filter(a => !rechnung.some(r => r.position === a.lv_position))\n  .map(a => a.lv_position);\n\nreturn [{\n  json: {\n    gepruefte_positionen: ergebnisse.length,\n    ergebnisse,\n    fehlende_auftragspositionen: fehlendePositionen,\n    gesamtstatus:\n      ergebnisse.length === auftrag.length &&\n      ergebnisse.every(e => e.status === 'OK') &&\n      fehlendePositionen.length === 0\n        ? 'ALLE POSITIONEN STIMMEN ÜBEREIN'\n        : 'PRÜFUNG ERFORDERLICH'\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        96
      ],
