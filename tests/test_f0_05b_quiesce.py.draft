# Testfall-Datensaetze fuer spaetere pytest/unittest-Umsetzung.
# 'assertions' sind fachliche Sollbedingungen; hier wird nichts ausgefuehrt.
SCENARIOS = [
    dict(id="QB01", name="gate_is_per_supervisor_instance",
         setup="Zwei Supervisor-Instanzen auf gemeinsamem Store; eigene IDs, verschiedene Worker",
         race="quiesce(A) parallel claim(B)",
         assertions=["A kann keinen Claim mehr committen", "B bleibt unabhaengig berechtigt", "kein Fremd-Lease geloest"]),
    dict(id="QB02", name="same_worker_id_is_not_owner_identity",
         setup="Zwei Supervisoren mit gleichlautendem worker_id",
         race="A quiesced, B beansprucht eigenen Job",
         assertions=["A darf B-Claim nicht _unclaimen", "ohne eindeutigen Nachweis -> pending statt Freigabe"]),
    dict(id="QB03", name="fast_reject_after_quiesce",
         setup="Gate A geschlossen; neuer Claim wartet noch vor Store-Lock",
         race="claim() gegen quiesce",
         assertions=["sofortige neutrale Nichtannahme", "QUEUED bleibt QUEUED", "attempts unveraendert"]),
    dict(id="QB04", name="store_lock_held_before_gate_closed",
         setup="Claim A haelt Store-Lock und wartet in scan; Quiesce A beginnt",
         race="Gate schliesst vor finalem Claim-Guard",
         assertions=["kein Claim-Commit nach Gate-Cut", "kein Deadlock", "queued job bleibt queued"]),
    dict(id="QB05", name="commit_inside_store_and_gate_locks",
         setup="Claim haelt Store+Gate und ist im mutate-Commit",
         race="quiesce fordert Gate gleichzeitig an",
         assertions=["Claim komplett vor Gate-Cut oder komplett abgelehnt", "kein Commit nach Cut"]),
    dict(id="QB06", name="quiesce_during_slot_grant",
         setup="_take_slot blockiert nach moeglichem Grant im separaten SQLite-Slot-Store",
         race="Gate schliesst waehrend slot grant",
         assertions=["kein Job-Claim", "eigener Slot zurueck in Wartestatus", "fremde Slot-Warteschlange bleibt"]),
    dict(id="QB07", name="slot_requeue_failure_does_not_claim_or_drain",
         setup="Slot gewaehlt; quiesce geschlossen; slot backend fail bei _slot_requeue",
         race="Claim-Exit waehrend Cleanup",
         assertions=["kein Claim-Commit", "PENDING/Audit", "keine stillschweigend verlorene Slot-Lease"]),
    dict(id="QB08", name="unclaim_previously_claimed_not_started",
         setup="Job vor Cut von A geclaimt, confirm_start noch nicht aufgerufen",
