         assertions=["Gate bleibt geschlossen", "Fehler separat sichtbar", "DRAINED nicht allein wegen Auditfehler behauptet"]),
    dict(id="QB16", name="foreign_lease_is_never_unclaimed",
         setup="fremder Claim mit identischem worker_id, aber anderem Claim-Snapshot",
         race="lokale Quiesce-Bereinigung",
         assertions=["fremder Job/Slot/Lease unveraendert", "wenn Ownership unklar -> PENDING"]),
    dict(id="QB17", name="unknown_mutation_not_replayed",
         setup="laufender mutierender Attempt mit unbekanntem Ergebnis",
         race="Shutdown / Restart",
         assertions=["kein automatisches Replay", "kein SUCCESS/CANCELLED behauptet", "bestehendes Recovery-Gate bleibt"]),
    dict(id="QB18", name="worker_loop_contract",
         setup="run_forever und Orchestra WorkerPool._loop mit no-claim/quiesced",
