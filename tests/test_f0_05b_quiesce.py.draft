         assertions=["_unclaim nur bei bewiesener lokaler Ownership", "worker=None", "attempts unveraendert", "Job QUEUED"]),
    dict(id="QB09", name="start_after_gate_closed_is_forbidden",
         setup="claim vor Cut, confirm_start loest Resolver/Loader aus",
         race="quiesce schliesst Gate vor _start_attempt",
         assertions=["kein neuer Attempt-Commit", "kein neuer Handler-Start", "lokaler Claim zurueck/sonst PENDING"]),
    dict(id="QB10", name="started_before_quiesce_stays_visible",
         setup="_start_attempt persistiert RUNNING vor Gate-Cut",
         race="quiesce wartet auf Gate-Release",
         assertions=["Attempt zaehlt als gestartet", "F0-05A tracked laufenden Worker", "keine automatische Mutation-Wiederholung"]),
    dict(id="QB11", name="claim_append_lock_timeout_neutral",
         setup="append_lock wirft RuntimeError('append_lock_timeout')",
         race="Worker.run_once und Supervisor.run_next",
         assertions=["keine unhandled RuntimeError", "neutrale Nichtannahme mit Audit-Grund", "kein Job-Fehler oder Attempt-Verbrauch"]),
    dict(id="QB12", name="other_runtimeerror_not_swallowed",
         setup="claim wirft RuntimeError('unexpected_fault')",
         race="Worker.run_once oder run_next",
         assertions=["unerwarteter Fehler bleibt diagnostizierbar", "nicht als quiesced/idle verschleiert"]),
    dict(id="QB13", name="retry_close_is_monotonic",
         setup="runtime.close() mehrfach parallel; erster Worker bleibt haengen",
         race="zweiter close bevor Drain endet",
         assertions=["Gate bleibt zu", "SHUTDOWN_PENDING bis Drain bewiesen", "kein vorschnelles SQLite-Schliessen"]),
    dict(id="QB14", name="gate_lock_timeout_fail_closed",
         setup="Gate-Lock wird laenger als Deadline gehalten",
         race="request_quiesce versucht Cut",
         assertions=["stop_requested klebt", "SHUTDOWN_PENDING", "neue Annahmen werden fail-closed abgewiesen"]),
    dict(id="QB15", name="audit_failure_cannot_reopen_gate",
         setup="Audit append wirft Ausnahme nach Gate-Cut",
